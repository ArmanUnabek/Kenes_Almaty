# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=os_journal
DB_USER=os_user
DB_PASS=change_me

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Almaty

# Session (idle timeout in seconds — maps to SESSION_IDLE_TIMEOUT_SECONDS)
SESSION_LIFETIME=7200
# Cookie Secure flag. Keep false for http://localhost dev; set true in production (HTTPS).
SESSION_SECURE=false

# Принудительная 2FA для админов. Оставьте false на первом запуске, иначе
# дефолтный админ не сможет войти (для входа нужна 2FA, а для 2FA — вход).
# Включите true после того, как админ настроит TOTP.
ENFORCE_ADMIN_2FA=false

# Pusher (realtime, optional)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu

# Email (notifications cron, optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# File uploads
UPLOAD_MAX_MB=10

# CORS (comma-separated origins, optional)
ALLOWED_ORIGINS=

# Telegram Bot (optional — for deadline notifications and bot commands)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MyOsJournalBot
TELEGRAM_WEBHOOK_SECRET=

# Cron web trigger (optional, for cron_deadlines.php via HTTP)
CRON_TOKEN=

# Health check (UptimeRobot, etc.) — GET /api/health.php?token=...
# If empty, only admin session can access health endpoint
HEALTH_CHECK_TOKEN=

# KazLLM (опционально) — перевод пользовательского контента через Ollama/llama.cpp
# См. docs/KAZLLM.md
KAZLLM_ENABLED=false
KAZLLM_API_URL=http://127.0.0.1:11434
KAZLLM_MODEL=kazllm
KAZLLM_PROVIDER=ollama
KAZLLM_TIMEOUT=120

# Moderators may email only regional users/members or these domains (comma-separated)
NOTIFY_ALLOWED_DOMAINS=gov.kz

# ─────────────────────────────────────────────────────────────────────────────
# The keys below are read by the app but were previously undocumented. Defaults
# shown match the code — leave as-is unless you use the feature.
# ─────────────────────────────────────────────────────────────────────────────

# Database driver/charset. Production is mysql/mariadb. (sqlite/pgsql branches
# exist in code but are not a supported deploy target.)
DB_DRIVER=mysql
DB_CHARSET=utf8mb4

# Verbose error output. MUST stay false in production.
DEBUG=false

# Admin IP allowlist (comma-separated). If set, admin-role sessions are rejected
# from any IP not listed. Leave empty to allow admins from any IP.
ADMIN_ALLOWED_IPS=

# Display name on outgoing email (pairs with SMTP_FROM above).
SMTP_FROM_NAME=Журнал ОС

# REST API keys (Bearer ak_… tokens). true enables the /api key auth path.
API_KEYS_ENABLED=true

# Shared secret for signing outgoing webhook payloads (HMAC). Empty = unsigned.
WEBHOOK_SECRET_KEY=

# SMS via Mobizon (optional). Enable, then set the API key.
SMS_ENABLED=false
SMS_PROVIDER=mobizon
MOBIZON_API_KEY=
MOBIZON_SENDER=InfoSMS

# Web Push notifications (VAPID, optional). Generate a VAPID keypair and set both.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# WhatsApp Cloud API (Meta Business, optional).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Redis (optional — rate-limit/cache backend). Empty host = filesystem fallback.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# KazLLM API key (only if your endpoint requires auth; see KAZLLM_* above).
KAZLLM_API_KEY=

# Log/queue retention for cron_cleanup.php (days). Floors: 30/30/7 respectively.
AUDIT_LOG_RETENTION_DAYS=365
ACTIVITY_LOG_RETENTION_DAYS=180
EMAIL_QUEUE_RETENTION_DAYS=90

